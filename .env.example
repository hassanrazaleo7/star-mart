# Local database uses .data/ when DATABASE_URL is empty. On Vercel, PostgreSQL is required.
DATABASE_URL=

# Customer signup, Google sign-in and mobile OTP use a Firebase project.
# Copy these client values from Firebase Console > Project settings > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Same Firebase project ID for backend ID-token verification.
FIREBASE_PROJECT_ID=

# Optional defaults for advance-payment accounts shown at checkout (editable in /admin → Store settings).
VITE_JAZZCASH_ACCOUNT=
VITE_EASYPAISA_ACCOUNT=
VITE_BANK_ACCOUNT=

# Optional hardening.
# Required by POST /api/setup when set, so the first visitor of a fresh deployment cannot claim the owner account.
SETUP_SECRET=
# Comma-separated origins allowed to send mutating requests (defaults to the request host).
APP_ORIGINS=
# Set to 1 when the server runs behind a reverse proxy you control (uses the last X-Forwarded-For hop).
TRUST_PROXY=
# Vercel cron authorization for /api/sweep (Vercel sets the Authorization header automatically).
CRON_SECRET=

# POS policy. Staff discounts are capped at the lower of these two (basis points of the subtotal, and paisa).
STAFF_MAX_DISCOUNT_BPS=500
STAFF_MAX_DISCOUNT_PAISA=50000
# Discounts above this amount (paisa) are flagged in the activity log.
ALERT_DISCOUNT_PAISA=20000

# Online order policy.
GUEST_ORDER_MAX_UNITS=10
GUEST_ORDER_EXPIRY_HOURS=2
CUSTOMER_ORDER_MAX_UNITS=50
CUSTOMER_ORDER_MAX_OPEN=3
CUSTOMER_ORDER_EXPIRY_HOURS=48
TRANSFER_ORDER_EXPIRY_HOURS=24
ACTIVITY_RETENTION_DAYS=180
