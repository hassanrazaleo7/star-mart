# Local database uses .data/ when DATABASE_URL is empty. On Vercel, PostgreSQL is required.
DATABASE_URL=

# Customer signup, Google sign-in and mobile OTP use a Firebase project.
# Copy these client values from Firebase Console > Project settings > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Same Firebase project ID for backend ID-token verification.
FIREBASE_PROJECT_ID=
